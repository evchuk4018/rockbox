{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rockbox: Build simulator",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Rockbox: Run simulator",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/run.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Rockbox: Build and run simulator",
      "dependsOrder": "sequence",
      "dependsOn": ["Rockbox: Build simulator", "Rockbox: Run simulator"],
      "problemMatcher": []
    },
    {
      "label": "Rockbox: Clean simulator (preserve storage)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/clean.ps1"],
      "problemMatcher": []
    }
  ]
}
