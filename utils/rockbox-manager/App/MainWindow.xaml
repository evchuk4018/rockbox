<Window x:Class="RockboxManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rockbox Manager" Width="1320" Height="850" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Closing="OnClosing">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{StaticResource Accent}" CornerRadius="10" Width="42" Height="42" Margin="0,0,13,0"><TextBlock Text="R" FontSize="26" FontWeight="Bold" Foreground="#10251A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <StackPanel><TextBlock Text="ROCKBOX MANAGER" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Your music. Your order." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0"><TextBlock x:Name="DeviceTitle" Text="Looking for your player…" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="DeviceDetails" Text="Connect your Clip+ with USB" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Right"/></StackPanel>
      <Button Grid.Column="2" Content="Refresh" Click="RefreshClick" VerticalAlignment="Center" Margin="0"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="242"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="12"><DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="YOUR PLAYER" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="Bold" Margin="10,8,0,14"/>
        <Button x:Name="NewButton" DockPanel.Dock="Bottom" Content="+  New playlist" Style="{StaticResource Primary}" Click="NewClick" Margin="0,14,0,0" IsEnabled="False"/>
        <ListBox x:Name="Navigation" SelectionChanged="NavigationChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Caption}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel></Border>
      <Grid Grid.Column="2">
        <Border x:Name="Editor" Background="{StaticResource Panel}" CornerRadius="12" Padding="20" Visibility="Collapsed"><Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock x:Name="ViewTitle" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ViewCaption" Foreground="{StaticResource Muted}" Margin="0,7,0,16" TextWrapping="Wrap"/></StackPanel>
            <StackPanel x:Name="PlaylistActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Rename" Click="RenameClick"/><Button Content="Duplicate" Click="DuplicateClick"/><Button Content="Delete" Click="DeleteClick" Margin="0"/></StackPanel>
          </Grid>
          <Border x:Name="ConflictBanner" Grid.Row="1" Background="#493D28" CornerRadius="8" Padding="12" Margin="0,0,0,14" Visibility="Collapsed"><StackPanel><TextBlock Text="The internal and SD copies differ. Choose the songs and order to keep." TextWrapping="Wrap" Margin="0,0,0,10"/><WrapPanel><Button Content="Use Internal Version" Click="UseInternalClick"/><Button Content="Use SD Version" Click="UseSdClick"/></WrapPanel></StackPanel></Border>
          <Grid x:Name="SearchPanel" Grid.Row="2" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel x:Name="CatalogPanel" Grid.ColumnSpan="4" Visibility="Collapsed" Margin="0,0,0,12"><TextBlock x:Name="CatalogLabel" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="CatalogPicker" DisplayMemberPath="Label" SelectionChanged="CatalogChanged" AutomationProperties.Name="Browse artist or album"/></StackPanel>
            <StackPanel Grid.Row="1"><TextBlock Text="SEARCH MUSIC" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><TextBox x:Name="SearchBox" TextChanged="FilterChanged" ToolTip="Search title, artist, album artist, album, genre, or filename" AutomationProperties.Name="Search music"/></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0"><TextBlock Text="STORAGE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="StorageFilter" SelectedIndex="0" SelectionChanged="FilterChanged"><ComboBoxItem Content="All storage"/><ComboBoxItem Content="Internal"/><ComboBoxItem Content="SD card"/></ComboBox></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="GENRE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,6"/><ComboBox x:Name="GenreFilter" SelectionChanged="FilterChanged" AutomationProperties.Name="Genre filter"/></StackPanel>
            <Button Grid.Row="1" Grid.Column="3" Content="Clear filters / sort" Click="ClearFiltersClick" VerticalAlignment="Bottom" Margin="0" Padding="10,10"/>
          </Grid>
          <WrapPanel x:Name="SongActions" Grid.Row="3" Margin="0,0,0,6">
            <ComboBox x:Name="AddTarget" Width="180" DisplayMemberPath="Name" Margin="0,0,8,8" ToolTip="Playlist to add selected songs to" AutomationProperties.Name="Destination playlist"/>
            <Button x:Name="AddButton" Content="Add selected" Click="AddClick" Margin="0,0,8,8"/>
            <Button x:Name="BrowseButton" Content="+ Add songs" Click="BrowseClick" Margin="0,0,8,8"/>
            <Button x:Name="RemoveButton" Content="Remove" Click="RemoveClick" Margin="0,0,8,8"/>
            <Button x:Name="UpButton" Content="↑ Up" Click="UpClick" Margin="0,0,8,8"/>
            <Button x:Name="DownButton" Content="↓ Down" Click="DownClick" Margin="0,0,8,8"/>
            <Button Content="♥ Like" Click="LikeClick" Margin="0,0,8,8"/><Button Content="Unlike" Click="UnlikeClick" Margin="0,0,0,8"/>
          </WrapPanel>
          <DataGrid x:Name="Songs" Grid.Row="4" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" Sorting="SongsSorting" PreviewMouseLeftButtonDown="SongsMouseDown" MouseMove="SongsMouseMove" AllowDrop="True" Drop="SongsDrop" SelectionChanged="SongsSelectionChanged">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="45" SortMemberPath="Index"/>
              <DataGridTextColumn Header="♥" Binding="{Binding Heart}" Width="38" CanUserSort="False"/>
              <DataGridTextColumn Header="TITLE" Binding="{Binding Track.Title}" Width="2*"/>
              <DataGridTextColumn Header="ARTIST" Binding="{Binding Track.Artist}" Width="1.5*"/>
              <DataGridTextColumn Header="ALBUM" Binding="{Binding Track.Album}" Width="1.5*"/>
              <DataGridTextColumn Header="ALBUM ARTIST" Binding="{Binding Track.GroupArtist}" Width="1.2*"/>
              <DataGridTextColumn Header="DISC" Binding="{Binding Track.DiscNumber}" Width="45"/>
              <DataGridTextColumn Header="TRACK" Binding="{Binding Track.TrackNumber}" Width="50"/>
              <DataGridTextColumn Header="GENRE" Binding="{Binding Track.Genre}" Width="*"/>
              <DataGridTextColumn Header="TIME" Binding="{Binding Track.DurationLabel}" SortMemberPath="Track.Duration" Width="65"/>
              <DataGridTextColumn Header="STORAGE" Binding="{Binding Location}" Width="95"/>
            </DataGrid.Columns>
          </DataGrid>
          <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="Black" Width="122" Height="122" Margin="0,0,14,0"><Image x:Name="CoverPreview" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" AutomationProperties.Name="Player cover preview"/></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="RowCount" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="CoverStatus" Text="Select a song to preview its cover." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock x:Name="ArtworkSummary" Text="Artwork will be prepared automatically." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            <Button x:Name="ArtworkRetry" Grid.Column="2" Content="Retry artwork" Click="ArtworkRetryClick" VerticalAlignment="Center" Margin="12,0,0,0"/>
          </Grid>
        </Grid></Border>
        <Border x:Name="ConnectionPanel" Background="{StaticResource Panel}" CornerRadius="12" Padding="50"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
          <TextBlock Text="♫" Foreground="{StaticResource Accent}" FontSize="64" HorizontalAlignment="Center"/>
          <TextBlock x:Name="ConnectionTitle" Text="Connect your Clip+" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Margin="0,16,0,12"/>
          <TextBlock x:Name="ConnectionText" Text="Plug your Rockbox player into USB. Your library and playlists will appear here." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="24"/>
          <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Height="3" Margin="0,24,0,0" Foreground="{StaticResource Accent}" Background="#29333F"/>
          <ComboBox x:Name="DevicePicker" DisplayMemberPath="Name" SelectionChanged="DevicePicked" Visibility="Collapsed" Margin="0,20,0,0"/>
        </StackPanel></Border>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18,14" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock x:Name="PendingTitle" Text="Ready when you are" FontWeight="SemiBold"/><TextBlock x:Name="StatusText" Text="Changes stay on this PC until you send them." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" MaxHeight="64"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Backups" Click="BackupsClick"/><Button x:Name="DiscardButton" Content="Discard changes" Click="DiscardClick" IsEnabled="False"/><Button x:Name="SendButton" Content="Send to Player →" Style="{StaticResource Primary}" Click="SendClick" IsEnabled="False" Margin="0" Padding="22,12"/></StackPanel>
    </Grid></Border>
  </Grid>
</Window>
