{
  "version": 4,
  "configurations": [
    {
      "name": "Sansa Clip Windows simulator (UCRT64)",
      "compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
      "intelliSenseMode": "windows-gcc-x64",
      "cStandard": "gnu11",
      "cppStandard": "gnu++17",
      "defines": ["SIMULATOR", "SANSA_CLIP", "DEBUG", "HAVE_TEST_PLUGINS"],
      "includePath": [
        "${workspaceFolder}/build-sansaclip-sim",
        "${workspaceFolder}",
        "${workspaceFolder}/apps",
        "${workspaceFolder}/apps/gui",
        "${workspaceFolder}/apps/recorder",
        "${workspaceFolder}/apps/radio",
        "${workspaceFolder}/apps/keymaps",
        "${workspaceFolder}/firmware/export",
        "${workspaceFolder}/firmware/include",
        "${workspaceFolder}/firmware/target/hosted",
        "${workspaceFolder}/firmware/target/hosted/sdl",
        "${workspaceFolder}/firmware/target/arm/as3525/sansa-clip",
        "${workspaceFolder}/firmware/target/arm/as3525",
        "${workspaceFolder}/firmware/target/arm",
        "${workspaceFolder}/uisimulator/common",
        "${workspaceFolder}/lib/rbcodec",
        "${workspaceFolder}/lib/rbcodec/codecs/lib",
        "C:/msys64/ucrt64/include/SDL2"
      ],
      "browse": { "path": ["${workspaceFolder}", "${workspaceFolder}/build-sansaclip-sim"] }
    }
  ]
}
